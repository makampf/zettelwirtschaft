#!/usr/bin/env bash
# Commit-Nachrichten nach Conventional Commits (englisch) – Grundlage für die automatische Versionierung.
# Beispiele: "feat: add yearly export", "fix(parser): keep spaced invoice numbers", "feat!: …" (Breaking Change)
betreff=$(head -n1 "$1")
if printf '%s' "$betreff" | grep -qE '^(Merge |Revert "|fixup! |squash! )'; then exit 0; fi
if ! printf '%s' "$betreff" | grep -qE '^(feat|fix|perf|refactor|docs|style|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ].{1,98}$'; then
  echo "✗ Commit-Nachricht entspricht nicht Conventional Commits:"
  echo "    $betreff"
  echo "  Format: <typ>(<bereich>)?: <kurze englische Beschreibung>"
  echo "  Typen:  feat, fix, perf, refactor, docs, style, test, build, ci, chore, revert"
  exit 1
fi
