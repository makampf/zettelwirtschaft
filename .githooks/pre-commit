#!/usr/bin/env bash
# Prüft neu hinzugefügte oder geänderte Dateien vor jedem Commit (siehe CLAUDE.md, Datenschutz)
mapfile -t dateien < <(git diff --cached --name-only --diff-filter=ACMR)
[ "${#dateien[@]}" -eq 0 ] && exit 0
exec "$(git rev-parse --show-toplevel)/scripts/privacy-check.sh" "${dateien[@]}"
