{
  "name": "zettelwirtschaft",
  "private": true,
  "version": "0.0.0-development",
  "type": "module",
  "description": "Arzt- und Pflegerechnungen verwalten und bei Beihilfe, privater Kranken- und Pflegeversicherung einreichen",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/makampf/zettelwirtschaft.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p server/tsconfig.json && node scripts/drittlizenzen.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "start": "node server/dist/index.js",
    "server:dev": "tsx watch server/src/index.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "datenschutz": "bash scripts/datenschutz-pruefung.sh",
    "release": "semantic-release"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.11",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@tesseract.js-data/deu": "^1.0.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semantic-release": "^25.0.9",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
