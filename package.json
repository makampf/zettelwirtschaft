{
  "name": "rechnungsmanager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Verwaltung von Arzt- und Pflegerechnungen mit Einreichungen bei Beihilfe, privater Kranken- und Pflegeversicherung",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "start": "node server/dist/index.js",
    "server:dev": "tsx watch server/src/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.11",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
